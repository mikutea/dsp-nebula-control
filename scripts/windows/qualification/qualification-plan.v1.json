{
  "protocol": "DYSON_PRODUCTION_QUALIFICATION_V1",
  "schemaVersion": 1,
  "planId": "dyson-production-qualification-v1",
  "title": "Dyson Control production qualification",
  "productionDefaults": {
    "mode": "preview",
    "productionWritesEnabled": false,
    "executeEnvironmentName": "DYSON_QUALIFICATION_EXECUTE_ENABLED",
    "executeEnvironmentValue": "ALLOW_BOUNDED_PRODUCTION_QUALIFICATION_V1",
    "confirmationPhraseTemplate": "EXECUTE DYSON QUALIFICATION SHADOW {UPPERCASE-ALLOWLISTED-ACTION} {canonical-request-id}",
    "maximumRequestAgeSeconds": 900,
    "maximumProtectionPointAgeSeconds": 1800,
    "maximumMaintenanceWindowSeconds": 14400,
    "targetIdentityMatchRequired": true,
    "pairedSaveUnit": ["dsv", "server"]
  },
  "receiptProtocol": {
    "hash": "sha256",
    "canonicalJson": true,
    "chainRequired": true,
    "duplicatePolicy": "same-id-and-digest-is-idempotent;otherwise-reject",
    "privateEvidenceReferences": "opaque-uuid-and-digest-only",
    "maximumReceiptLifetimeSeconds": 86400,
    "publicOutput": "fixed-redacted-summary-only"
  },
  "externalClientProtocol": {
    "stepId": "external-client-e2e",
    "maximumTotalSeconds": 2400,
    "freshReconnectChallengeRequired": true,
    "forbiddenSubstituteEvidence": ["http-status", "tcp-port-open", "client-self-report"],
    "events": [
      "client-challenge-issued",
      "game-address-resolved",
      "game-authenticated",
      "game-joined",
      "game-interaction-observed",
      "save-requested",
      "save-independently-acknowledged",
      "game-disconnected",
      "reconnect-challenge-issued",
      "game-rejoined",
      "external-sequence-complete"
    ],
    "collectsIdentity": false,
    "collectsNetworkAddress": false
  },
  "steps": [
    {
      "id": "side-by-side-deployment",
      "acceptanceIds": ["PRD-001"],
      "title": "Side-by-side deployment with unchanged authority",
      "prerequisites": ["release-digest-recorded", "data-boundary-preflight-passed", "gsmanager-recovery-package-verified"],
      "timeoutSeconds": 3600,
      "riskClass": "bounded-mutation",
      "actionAdapter": "side-by-side-deployment-v1",
      "idempotency": "run-step-attempt",
      "checkpointStates": ["previewed", "executing", "verifying", "passed", "failed", "rollback-pending", "rolled-back", "interrupted"],
      "resumeStrategy": "reconcile-private-receipts-before-next-action",
      "interruptible": true,
      "privateEvidenceReferenceRequired": true,
      "evidenceTypes": ["release-identity", "authority-inventory", "candidate-health", "gsmanager-recoverability"]
    },
    {
      "id": "authenticated-panel",
      "acceptanceIds": ["PRD-002"],
      "title": "Authenticated TLS panel and loopback listener",
      "prerequisites": ["side-by-side-deployment-passed", "approved-maintenance-window"],
      "timeoutSeconds": 1800,
      "riskClass": "read-only",
      "actionAdapter": "panel-observation-v1",
      "idempotency": "run-step-attempt",
      "checkpointStates": ["previewed", "verifying", "passed", "failed", "interrupted"],
      "resumeStrategy": "repeat-observation-with-fresh-challenge",
      "interruptible": true,
      "privateEvidenceReferenceRequired": true,
      "evidenceTypes": ["tls-route-observation", "authenticated-panel-observation", "listener-boundary-observation"]
    },
    {
      "id": "game-protocol-path",
      "acceptanceIds": ["PRD-003"],
      "title": "Game protocol path and proxy bypass",
      "prerequisites": ["side-by-side-deployment-passed", "independent-observer-ready"],
      "timeoutSeconds": 1800,
      "riskClass": "read-only",
      "actionAdapter": "game-path-observation-v1",
      "idempotency": "run-step-attempt",
      "checkpointStates": ["previewed", "verifying", "passed", "failed", "interrupted"],
      "resumeStrategy": "repeat-game-protocol-challenge",
      "interruptible": true,
      "privateEvidenceReferenceRequired": true,
      "evidenceTypes": ["dynamic-resolution-observation", "game-protocol-handshake", "proxy-bypass-observation"]
    },
    {
      "id": "external-client-e2e",
      "acceptanceIds": ["PRD-004"],
      "title": "External join, interaction, save, disconnect, and reconnect",
      "prerequisites": ["game-protocol-path-passed", "external-client-operator-ready", "private-evidence-store-ready"],
      "timeoutSeconds": 2400,
      "riskClass": "human-coordinated",
      "actionAdapter": "external-client-challenge-v1",
      "idempotency": "challenge-id-and-event",
      "checkpointStates": ["previewed", "awaiting-human", "verifying", "passed", "failed", "interrupted"],
      "resumeStrategy": "issue-fresh-challenge-after-last-authoritative-receipt",
      "interruptible": true,
      "privateEvidenceReferenceRequired": true,
      "evidenceTypes": ["operator-client-challenge", "server-authoritative-join", "server-authoritative-interaction", "independent-paired-save-observation", "server-authoritative-disconnect", "server-authoritative-rejoin", "dual-party-sequence-attestation"]
    },
    {
      "id": "paired-save-restore",
      "acceptanceIds": ["SAV-005", "PRD-005"],
      "title": "Atomic paired-save save and restore drill",
      "prerequisites": ["fresh-paired-save-protection-point", "restore-target-identity-matched", "rollback-defined"],
      "timeoutSeconds": 3600,
      "riskClass": "dangerous",
      "actionAdapter": "paired-save-restore-v1",
      "idempotency": "canonical-request-id",
      "checkpointStates": ["previewed", "executing", "verifying", "passed", "failed", "rollback-pending", "rolled-back", "interrupted"],
      "resumeStrategy": "verify-atomic-pair-and-reconcile-transaction",
      "interruptible": true,
      "privateEvidenceReferenceRequired": true,
      "evidenceTypes": ["paired-save-protection", "save-independent-acknowledgement", "restore-load-observation", "rollback-receipt"]
    },
    {
      "id": "windows-reboot-recovery",
      "acceptanceIds": ["PRD-005"],
      "title": "Windows reboot recovery",
      "prerequisites": ["fresh-paired-save-protection-point", "startup-checkpoint-armed", "maintenance-window-open"],
      "timeoutSeconds": 1800,
      "riskClass": "dangerous",
      "actionAdapter": "windows-reboot-v1",
      "idempotency": "canonical-request-id",
      "checkpointStates": ["previewed", "executing", "interrupted", "verifying", "passed", "failed", "rollback-pending", "rolled-back"],
      "resumeStrategy": "resume-from-pre-reboot-checkpoint-and-reconcile-boot-identity",
      "interruptible": true,
      "privateEvidenceReferenceRequired": true,
      "evidenceTypes": ["pre-reboot-checkpoint", "boot-identity-observation", "control-plane-recovery", "game-load-observation"]
    },
    {
      "id": "control-plane-restart-recovery",
      "acceptanceIds": ["PRD-005"],
      "title": "Control-plane restart and checkpoint recovery",
      "prerequisites": ["durable-checkpoint-verified", "no-game-lifecycle-action-pending"],
      "timeoutSeconds": 900,
      "riskClass": "dangerous",
      "actionAdapter": "control-plane-restart-v1",
      "idempotency": "canonical-request-id",
      "checkpointStates": ["previewed", "executing", "interrupted", "verifying", "passed", "failed", "rollback-pending", "rolled-back"],
      "resumeStrategy": "reload-checkpoint-and-reject-duplicate-action",
      "interruptible": true,
      "privateEvidenceReferenceRequired": true,
      "evidenceTypes": ["pre-restart-checkpoint", "process-identity-change", "job-reconciliation", "duplicate-suppression"]
    },
    {
      "id": "game-crash-recovery",
      "acceptanceIds": ["PRD-005"],
      "title": "DSP crash recovery",
      "prerequisites": ["shadow-fault-plan-validated", "fresh-paired-save-protection-point", "maintenance-window-open"],
      "timeoutSeconds": 1800,
      "riskClass": "dangerous",
      "actionAdapter": "game-crash-recovery-v1",
      "idempotency": "canonical-request-id",
      "checkpointStates": ["previewed", "executing", "interrupted", "verifying", "passed", "failed", "rollback-pending", "rolled-back"],
      "resumeStrategy": "reconcile-process-and-save-pair-before-recovery",
      "interruptible": true,
      "privateEvidenceReferenceRequired": true,
      "evidenceTypes": ["fault-boundary-receipt", "crash-observation", "recovery-attempt", "save-load-observation"]
    },
    {
      "id": "storage-interruption-recovery",
      "acceptanceIds": ["PRD-005"],
      "title": "Bounded temporary storage interruption",
      "prerequisites": ["isolated-storage-target-matched", "fresh-paired-save-protection-point", "automatic-timeout-armed"],
      "timeoutSeconds": 1200,
      "riskClass": "dangerous",
      "actionAdapter": "storage-interruption-v1",
      "idempotency": "canonical-request-id",
      "checkpointStates": ["previewed", "executing", "interrupted", "verifying", "passed", "failed", "rollback-pending", "rolled-back"],
      "resumeStrategy": "restore-storage-first-then-reconcile-save-transaction",
      "interruptible": true,
      "privateEvidenceReferenceRequired": true,
      "evidenceTypes": ["bounded-interruption-receipt", "automatic-restoration", "write-failure-observation", "post-restoration-integrity"]
    },
    {
      "id": "controlled-disk-pressure",
      "acceptanceIds": ["PRD-005"],
      "title": "Controlled disk pressure with reserved recovery margin",
      "prerequisites": ["isolated-pressure-target-matched", "reserved-free-space-proven", "automatic-cleanup-armed", "fresh-paired-save-protection-point"],
      "timeoutSeconds": 1800,
      "riskClass": "dangerous",
      "actionAdapter": "disk-pressure-v1",
      "idempotency": "canonical-request-id",
      "checkpointStates": ["previewed", "executing", "interrupted", "verifying", "passed", "failed", "rollback-pending", "rolled-back"],
      "resumeStrategy": "remove-bounded-fixture-and-verify-free-space-before-resume",
      "interruptible": true,
      "privateEvidenceReferenceRequired": true,
      "evidenceTypes": ["capacity-baseline", "bounded-allocation-receipt", "threshold-observation", "cleanup-and-capacity-restoration"]
    },
    {
      "id": "update-rollback",
      "acceptanceIds": ["PRD-005"],
      "title": "Update failure and previous-version rollback",
      "prerequisites": ["previous-release-digest-recorded", "fresh-paired-save-protection-point", "rollback-package-verified"],
      "timeoutSeconds": 3600,
      "riskClass": "dangerous",
      "actionAdapter": "update-rollback-v1",
      "idempotency": "canonical-request-id",
      "checkpointStates": ["previewed", "executing", "interrupted", "verifying", "passed", "failed", "rollback-pending", "rolled-back"],
      "resumeStrategy": "reconcile-active-release-and-complete-or-rollback",
      "interruptible": true,
      "privateEvidenceReferenceRequired": true,
      "evidenceTypes": ["release-protection", "failure-observation", "rollback-receipt", "previous-version-load-observation"]
    },
    {
      "id": "gsmanager-recoverable-switch",
      "acceptanceIds": ["CUT-001", "CUT-002", "CUT-003"],
      "title": "Recoverable GSManager authority switch and removal gate",
      "prerequisites": ["gsmanager-recovery-package-verified", "external-client-e2e-passed", "all-recovery-drills-passed", "six-hour-soak-passed", "maintenance-window-open"],
      "timeoutSeconds": 7200,
      "riskClass": "dangerous",
      "actionAdapter": "gsmanager-recoverable-switch-v1",
      "idempotency": "canonical-request-id",
      "checkpointStates": ["previewed", "executing", "interrupted", "verifying", "passed", "failed", "rollback-pending", "rolled-back"],
      "resumeStrategy": "restore-last-declared-authority-before-retry",
      "interruptible": true,
      "privateEvidenceReferenceRequired": true,
      "evidenceTypes": ["recovery-package", "authority-inventory", "switch-receipt", "rollback-drill", "post-switch-observation"]
    },
    {
      "id": "six-hour-soak",
      "acceptanceIds": ["PRD-005", "CUT-003"],
      "title": "Six-hour sustained operation",
      "prerequisites": ["external-client-e2e-passed", "recovery-drills-passed", "private-metrics-retention-ready"],
      "timeoutSeconds": 23400,
      "minimumRealElapsedSeconds": 21600,
      "riskClass": "read-only",
      "actionAdapter": "soak-observation-v1",
      "idempotency": "run-step-attempt",
      "checkpointStates": ["previewed", "verifying", "interrupted", "passed", "failed"],
      "resumeStrategy": "resume-observation-without-counting-unobserved-time",
      "interruptible": true,
      "privateEvidenceReferenceRequired": true,
      "evidenceTypes": ["monotonic-start", "periodic-health-observations", "save-latency-observations", "monotonic-end", "elapsed-time-attestation"],
      "virtualClockAllowedForProductionEvidence": false
    }
  ]
}
