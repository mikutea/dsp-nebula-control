{
  "name": "@dyson-control/api",
  "version": "0.1.0-rc.27",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
