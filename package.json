{
  "name": "dsp-nebula-control",
  "version": "0.1.0-rc.26",
  "private": true,
  "description": "A safety-first control plane for Dyson Sphere Program and Nebula multiplayer servers.",
  "license": "GPL-3.0-only",
  "scripts": {
    "install:all": "npm install --prefix apps/api && npm install --prefix apps/web",
    "build": "npm --prefix apps/web run build && npm --prefix apps/api run build",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm --prefix apps/api run dev\" \"npm --prefix apps/web run dev\"",
    "test": "npm --prefix apps/api run test && npm --prefix apps/web run test",
    "typecheck": "npm --prefix apps/api run typecheck && npm --prefix apps/web run typecheck",
    "version:check": "node scripts/validate-version-consistency.mjs",
    "version:selftest": "node --test scripts/validate-version-consistency.test.mjs",
    "acceptance:check": "node scripts/validate-acceptance.mjs",
    "acceptance:selftest": "node --test scripts/validate-acceptance.test.mjs",
    "acceptance:summary": "node scripts/validate-acceptance.mjs --summary",
    "acceptance:gate": "node scripts/validate-acceptance.mjs --require-release-ready",
    "bridge:protocol-check": "dotnet run --project integrations/dyson-control-bridge/protocol-tests/DysonControlBridge.ProtocolTests.csproj --configuration Release",
    "bridge:selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/bridge/SelfTest-DysonControlBridge.ps1",
    "migration:selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/migration/SelfTest-DysonGsManagerMigration.ps1",
    "migration:removal-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/migration/SelfTest-DysonGsManagerRemoval.ps1",
    "bridge:build": "dotnet build integrations/dyson-control-bridge/DysonControlBridge.csproj --configuration Release",
    "bridge:target-build": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/bridge/Build-DysonControlBridgeCandidate.ps1",
    "bridge:target-verify": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/bridge/Test-DysonControlBridgeCandidate.ps1",
    "powershell:check": "node scripts/validate-powershell.mjs",
    "host-mutation:selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/SelfTest-DysonHostMutationLease.ps1",
    "runtime-tasks:selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/SelfTest-DysonRuntimeTasks.ps1",
    "game-bootstrap:selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/bootstrap/SelfTest-DysonGameLifecycleBootstrap.ps1",
    "lifecycle:broker-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/lifecycle-broker/SelfTest-DysonLifecycleBroker.ps1",
    "cutover:authority-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/cutover/SelfTest-DysonGsManagerAuthority.ps1",
    "cutover:host-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/cutover/SelfTest-DysonCutoverHost.ps1",
    "cutover:broker-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/cutover-broker/SelfTest-DysonCutoverBroker.ps1",
    "cutover:selftest": "npm run cutover:authority-selftest && npm run cutover:host-selftest && npm run cutover:broker-selftest",
    "evidence:selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/evidence/SelfTest-DysonPrivateEvidenceBundle.ps1",
    "data-recovery:selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/data-recovery/SelfTest-DysonDataRootRecovery.ps1",
    "nebula-hostname-wss:selftest": "node --test scripts/nebula-hostname-wss/nebula-hostname-wss.test.mjs",
    "nebula-private-build:selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"%npm_config_local_prefix%\\scripts\\windows\\nebula-private-build\\SelfTest-NebulaPrivateBuild.ps1\"",
    "hostname-wss:qualification-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/network/SelfTest-DysonHostnameWssQualification.ps1",
    "network:selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/network/SelfTest-DysonNebulaNetwork.ps1",
    "network:v2-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/network/SelfTest-DysonNebulaNetworkV2.ps1",
    "qualification:selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/qualification/Invoke-QualificationSelfTest.ps1",
    "qualification:v2-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/qualification/Invoke-QualificationV2SelfTest.ps1",
    "qualification:orchestration-v2-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/qualification/Invoke-QualificationOrchestrationV2SelfTest.ps1",
    "qualification:panel-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/qualification/SelfTest-DysonControlPanelObservationV2.ps1",
    "qualification:side-by-side-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/qualification/SelfTest-DysonSideBySideObservationV2.ps1",
    "qualification:paired-save-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/qualification/SelfTest-DysonQualificationPairedSaveLoadObservationV2.ps1",
    "qualification:paired-save-record-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/qualification/SelfTest-DysonQualificationPairedSaveLoadRecordV2.ps1",
    "qualification:external-join-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/qualification/SelfTest-DysonExternalJoinObservationV2.ps1",
    "qualification:reversible-cutover-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/qualification/SelfTest-DysonQualificationReversibleCutoverObservationV2.ps1",
    "qualification:post-removal-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/qualification/SelfTest-DysonPostGsManagerRemovalObservationV2.ps1",
    "qualification:soak-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/qualification/SelfTest-DysonSoakObservationV2.ps1",
    "configuration:selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/configuration/SelfTest-DysonControlConfiguration.ps1",
    "deployment:selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/deployment/SelfTest-DysonControlDeployment.ps1",
    "deployment:configuration-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/deployment/SelfTest-DysonDeploymentConfigurationIntegration.ps1",
    "game-bootstrap:access-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/deployment/SelfTest-DysonGameBootstrapAccess.ps1",
    "node-runtime:selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/deployment/SelfTest-DysonNodeRuntimeProtection.ps1",
    "deployment:status-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/deployment/SelfTest-DysonControlDeploymentStatus.ps1",
    "deployment:reboot-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/deployment/SelfTest-DysonRebootAcceptance.ps1",
    "session:selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/session/SelfTest-DysonInteractiveSession.ps1",
    "release:artifact": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/release/New-DysonControlReleaseArtifact.ps1",
    "release:artifact-check": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/release/Test-DysonControlReleaseArtifact.ps1",
    "release:selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/release/SelfTest-DysonControlReleaseArtifact.ps1",
    "release:package": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/release/New-DysonControlReleasePackage.ps1",
    "release:package-check": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/release/Test-DysonControlReleasePackage.ps1",
    "release:package-selftest": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows/release/SelfTest-DysonControlReleasePackage.ps1",
    "release:workflow-selftest": "node --test scripts/windows/release/release-workflow.test.mjs",
    "public-release:check": "node scripts/public-release/check.mjs --history",
    "public-release:selftest": "node --test scripts/public-release/scanner.test.mjs",
    "check": "npm run version:check && npm run version:selftest && npm run build && npm run acceptance:check && npm run acceptance:selftest && npm run public-release:selftest && npm run bridge:protocol-check && npm run powershell:check && npm run host-mutation:selftest && npm run runtime-tasks:selftest && npm run game-bootstrap:selftest && npm run lifecycle:broker-selftest && npm run cutover:selftest && npm run bridge:selftest && npm run migration:selftest && npm run migration:removal-selftest && npm run evidence:selftest && npm run data-recovery:selftest && npm run nebula-hostname-wss:selftest && npm run nebula-private-build:selftest && npm run hostname-wss:qualification-selftest && npm run network:selftest && npm run network:v2-selftest && npm run qualification:selftest && npm run qualification:v2-selftest && npm run qualification:orchestration-v2-selftest && npm run qualification:panel-selftest && npm run qualification:side-by-side-selftest && npm run qualification:paired-save-selftest && npm run qualification:paired-save-record-selftest && npm run qualification:external-join-selftest && npm run qualification:reversible-cutover-selftest && npm run qualification:post-removal-selftest && npm run qualification:soak-selftest && npm run configuration:selftest && npm run node-runtime:selftest && npm run game-bootstrap:access-selftest && npm run deployment:configuration-selftest && npm run deployment:selftest && npm run deployment:status-selftest && npm run deployment:reboot-selftest && npm run session:selftest && npm run release:selftest && npm run release:package-selftest && npm run release:workflow-selftest && npm run typecheck && npm test",
    "hash-password": "npm --prefix apps/api run hash-password --"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
