# Safe defaults: demo provider and loopback-only HTTP listener.
NODE_ENV=development
DYSON_HOST=127.0.0.1
DYSON_PORT=13010
DYSON_PROVIDER=demo
DYSON_PUBLIC_ORIGIN=http://127.0.0.1:13010

# Development only. Production refuses to start without a password hash and
# a random session secret. Never reuse the Nebula game password here.
DYSON_DEV_ADMIN_PASSWORD=change-this-development-password
# DYSON_ADMIN_PASSWORD_HASH=scrypt$...
# Optional least-privilege accounts. Leave unset to disable that role.
# DYSON_OPERATOR_PASSWORD_HASH=scrypt$...
# DYSON_VIEWER_PASSWORD_HASH=scrypt$...
# DYSON_SESSION_SECRET=at-least-32-random-characters
# Independent signed-cursor secret for the redacted console log stream.
# Do not reuse the session, Nebula, bridge, or Steam credential.
# DYSON_CONSOLE_CURSOR_SECRET=another-at-least-32-random-characters

# Windows provider (disabled unless DYSON_PROVIDER=windows).
# DYSON_PROJECT_ROOT=C:\GameServers\DSP
# DYSON_SCRIPT_ROOT=C:\Program Files\DysonControl\scripts\windows
# DYSON_STATUS_TIMEOUT_MS=15000
# Development/test default to no background polling; production defaults to
# 15000 ms. Set 0 only when an external collector owns the sampling schedule.
# DYSON_OBSERVABILITY_INTERVAL_MS=15000
# DYSON_OBSERVABILITY_HISTORY_CAPACITY=2048
# Durable alert episodes keep only bounded public fields. Recovery requires
# three complete healthy observations by default; unavailable telemetry never
# closes an alert.
# DYSON_OBSERVABILITY_ALERT_CAPACITY=256
# DYSON_OBSERVABILITY_ALERT_RESOLVE_AFTER_MISSING_SAMPLES=3
# DYSON_DEPLOYMENT_VERSION=0.1.0

# Offline update staging is separately opt-in and never activates a release.
DYSON_UPDATE_STAGING_ENABLED=false
# Server-bound provider downloads remain independently disabled until the
# operator enables them. This gate writes only to the fixed update inbox.
DYSON_UPDATE_ACQUISITION_ENABLED=false
# Acquired component archives still require a separate identity/layout
# normalization step before they can become activation candidates.
DYSON_UPDATE_PREPARATION_ENABLED=false
# DYSON_UPDATE_INBOX_ROOT=C:\ProgramData\DysonControl\update-inbox
# DYSON_UPDATE_STAGING_ROOT=C:\ProgramData\DysonControl\staging
# Server-owned reviewed policy. The browser can never submit or override it.
# DYSON_UPDATE_COMPATIBILITY_POLICY_FILE=C:\ProgramData\DysonControl\compatibility-policy.json

# Component activation is a second, independent gate. It additionally requires
# the Windows provider, lifecycle execution, and the fixed staging roots above.
DYSON_UPDATE_ACTIVATION_ENABLED=false
# Explicit crash recovery is intentionally independent from ordinary activation.
DYSON_UPDATE_ACTIVATION_RECOVERY_ENABLED=false

# Managed mod publication has its own fail-closed gate and two fixed roots.
# Browser requests contain logical IDs and manifests only; never paths or ZIP bytes.
# Converting an acquired Thunderstore receipt into the fixed staging layout is
# an independent mutation and remains disabled even when downloads are enabled.
DYSON_MOD_IMPORT_ENABLED=false
DYSON_MOD_DEPLOYMENT_ENABLED=false
# Explicit broker-bound recovery is independent from ordinary mod publication.
DYSON_MOD_DEPLOYMENT_RECOVERY_ENABLED=false
# DYSON_MOD_STAGING_ROOT=C:\Fictional\Dyson\staged-mods
# Must be this exact subtree below DYSON_PROJECT_ROOT so ordinary mods can
# never replace Nebula, BepInEx, or Dyson Control's owned plugin directories.
# DYSON_MOD_PLUGINS_ROOT=C:\GameServers\DSP\server\BepInEx\plugins\dyson-managed-mods
# DYSON_MOD_SNAPSHOT_LIMIT=8

# Backup/restore execution is a separate fail-closed gate. Preview remains
# available; restore also requires verified stopped-process and closed-port evidence.
DYSON_SAVE_MUTATIONS_ENABLED=false

# Backup annotation, recoverable retirement/restore and grace-period purge use
# a distinct Administrator gate. Permanent purge remains impossible before the
# server-side minimum age, regardless of browser state.
DYSON_SAVE_RETENTION_MUTATIONS_ENABLED=false
# DYSON_SAVE_RETENTION_PURGE_MINIMUM_HOURS=168

# Configuration snapshots remain readable when this gate is disabled. Creating
# snapshots, restoring one, and interrupted-restore reconciliation require it.
DYSON_CONFIG_HISTORY_MUTATIONS_ENABLED=false

# Raw paired-save export/import is separately administrator-only and disabled.
# Imports stop in a fixed quarantine and never restore the active save.
DYSON_SAVE_TRANSFER_ENABLED=false
# DYSON_SAVE_TRANSFER_ROOT=C:\GameServers\DSP\transfers

# Real lifecycle execution is separately disabled even with the Windows status
# provider. Enable it only after installing the matching bridge and fixed tasks.
DYSON_LIFECYCLE_ENABLED=false
# DYSON_LIFECYCLE_TIMEOUT_MS=240000
# DYSON_BRIDGE_CONTROL_ROOT=C:\GameServers\DSP\run\control-bridge
# DYSON_BRIDGE_SECRET_FILE=C:\ProgramData\DysonControl\bridge.secret
# DYSON_BRIDGE_PLUGIN_VERSION=0.1.0
# DYSON_PLAYER_SNAPSHOT_MAX_AGE_MS=10000
# Privacy-bounded SQLite player presence event window. Both limits are enforced
# during ingest/access and by idle-time maintenance: capacity 1..2048 events,
# retention 1..720 hours. The current authoritative roster is stored separately.
# DYSON_PLAYER_HISTORY_CAPACITY=512
# DYSON_PLAYER_HISTORY_RETENTION_HOURS=168
# DYSON_SERVER_TASK=Dyson-Nebula-Server
# DYSON_STOP_TASK=Dyson-Nebula-Stop
# DYSON_GAME_PORT=8469
