# Safe defaults: demo provider and loopback-only HTTP listener.
NODE_ENV=development
DYSON_HOST=127.0.0.1
DYSON_PORT=13010
DYSON_PROVIDER=demo
DYSON_PUBLIC_ORIGIN=http://127.0.0.1:13010

# Development only. Production refuses to start without a password hash and
# a random session secret. Never reuse the Nebula game password here.
DYSON_DEV_ADMIN_PASSWORD=change-this-development-password
# DYSON_ADMIN_PASSWORD_HASH=scrypt$...
# Optional least-privilege accounts. Leave unset to disable that role.
# DYSON_OPERATOR_PASSWORD_HASH=scrypt$...
# DYSON_VIEWER_PASSWORD_HASH=scrypt$...
# DYSON_SESSION_SECRET=at-least-32-random-characters
# Independent signed-cursor secret for the redacted console log stream.
# Do not reuse the session, Nebula, bridge, or Steam credential.
# DYSON_CONSOLE_CURSOR_SECRET=another-at-least-32-random-characters

# Windows provider (disabled unless DYSON_PROVIDER=windows).
# All paths and account values below are fictional. The deployment runtime is
# selected separately with -NodeExecutable and must be an independent Node.js
# 24-or-newer installation; do not borrow a game manager's bundled runtime.
# DYSON_PROJECT_ROOT=C:\GameServer\Example\DSP
# Durable application data. Cutover requires this to be explicit and absolute.
# DYSON_DATA_DIR=C:\GameServer\Example\DysonControlData\data
# DYSON_SCRIPT_ROOT=C:\GameServer\Example\DysonControl\releases\0.2.0\scripts\windows
# Stable game lifecycle wrappers installed outside immutable release directories.
# DYSON_RUNTIME_BOOTSTRAP_ROOT=C:\GameServer\Example\DysonControl\bootstrap
# DYSON_STATUS_TIMEOUT_MS=15000
# Development/test default to no background polling; production defaults to
# 15000 ms. Set 0 only when an external collector owns the sampling schedule.
# DYSON_OBSERVABILITY_INTERVAL_MS=15000
# DYSON_OBSERVABILITY_HISTORY_CAPACITY=2048
# Durable alert episodes keep only bounded public fields. Recovery requires
# three complete healthy observations by default; unavailable telemetry never
# closes an alert.
# DYSON_OBSERVABILITY_ALERT_CAPACITY=256
# DYSON_OBSERVABILITY_ALERT_RESOLVE_AFTER_MISSING_SAMPLES=3
# DYSON_DEPLOYMENT_VERSION=0.1.0-rc.14

# Qualified hostname-preserving Nebula/WSS client profiles are independently
# disabled. If this gate is true, or if any binding below is present, all seven
# bindings are required together with DYSON_PROVIDER=windows. The six roots are
# installer-owned fixed siblings below <DataRoot>\data\qualified-client; the
# browser/API can submit only an opaque qualification ID, never these paths,
# receipt bodies, verification flags, or signing material.
DYSON_QUALIFIED_CLIENT_PROFILE_ENABLED=false
# DYSON_CLIENT_QUALIFICATION_EVIDENCE_ROOT=C:\GameServer\Example\DysonControlData\data\qualified-client\evidence
# DYSON_CLIENT_QUALIFICATION_BUILD_HARVEST_ROOT_A=C:\GameServer\Example\DysonControlData\data\qualified-client\build-harvest-a
# DYSON_CLIENT_QUALIFICATION_BUILD_HARVEST_ROOT_B=C:\GameServer\Example\DysonControlData\data\qualified-client\build-harvest-b
# DYSON_CLIENT_QUALIFICATION_KEY_RING_ROOT=C:\GameServer\Example\DysonControlData\data\qualified-client\key-ring
# DYSON_CLIENT_QUALIFICATION_REPLAY_ROOT=C:\GameServer\Example\DysonControlData\data\qualified-client\replay
# DYSON_QUALIFIED_CLIENT_ISSUE_ROOT=C:\GameServer\Example\DysonControlData\data\qualified-client\issued
# DYSON_CLIENT_QUALIFICATION_AUTHORITY=example.com

# Offline update staging is separately opt-in and never activates a release.
DYSON_UPDATE_STAGING_ENABLED=false
# Server-bound provider downloads remain independently disabled until the
# operator enables them. This gate writes only to the fixed update inbox.
DYSON_UPDATE_ACQUISITION_ENABLED=false
# Acquired component archives still require a separate identity/layout
# normalization step before they can become activation candidates.
DYSON_UPDATE_PREPARATION_ENABLED=false
# DYSON_UPDATE_INBOX_ROOT=C:\GameServer\Example\DysonControlData\update-inbox
# DYSON_UPDATE_STAGING_ROOT=C:\GameServer\Example\DysonControlData\staging
# Server-owned reviewed policy. The browser can never submit or override it.
# DYSON_UPDATE_COMPATIBILITY_POLICY_FILE=C:\GameServer\Example\DysonControlData\compatibility-policy.json

# Component activation is a second, independent gate. It additionally requires
# the Windows provider, lifecycle execution, and the fixed staging roots above.
DYSON_UPDATE_ACTIVATION_ENABLED=false
# Explicit crash recovery is intentionally independent from ordinary activation.
DYSON_UPDATE_ACTIVATION_RECOVERY_ENABLED=false
# Official Steam client handoff remains account-free and manual. Enabling it
# additionally requires Windows lifecycle execution, a trusted compatibility
# policy, and a fixed host transaction provider; missing capability stays 503.
DYSON_STEAM_MANUAL_HANDOFF_ENABLED=false

# Whole-tree Nebula plugin publication is independent from component activation,
# ordinary mod deployment, and lifecycle execution. Read-only plan/preview/verify
# requests contain identifiers and digests only. Apply and rollback stay closed
# behind the ordinary gate; crash recovery has its own Administrator-only gate.
DYSON_NEBULA_PLUGIN_TRANSACTION_ENABLED=false
DYSON_NEBULA_PLUGIN_TRANSACTION_RECOVERY_ENABLED=false
# Fixed private build-job root. It must be an absolute non-root path outside the
# entire DYSON_PROJECT_ROOT tree and disjoint from both the derived
# <DYSON_PROJECT_ROOT>\server game root and DYSON_DATA_DIR. The derived game root
# and DYSON_DATA_DIR must also be disjoint.
# DYSON_NEBULA_PLUGIN_JOB_BASE=C:\GameServer\Example\DysonPrivateBuildJobs

# GSManager -> Dyson Control authority transfer is a separate maintenance
# capability. Both gates stay closed until the private, host-generated profile
# and fixed runtime-task transaction root have been reviewed. Recovery can be
# enabled without enabling a new ordinary cutover request.
DYSON_CUTOVER_ENABLED=false
DYSON_CUTOVER_RECOVERY_ENABLED=false
# DYSON_CUTOVER_PROFILE_FILE=C:\GameServer\Example\DysonControlData\data\authority-inventory\authority-profile.json
# DYSON_CUTOVER_SERVICE_USER=.\ExampleGameService
# DYSON_CUTOVER_TASK_TRANSACTION_ROOT=C:\GameServer\Example\DysonControlData\data\runtime-task-transactions

# Managed mod publication has its own fail-closed gate and two fixed roots.
# Browser requests contain logical IDs and manifests only; never paths or ZIP bytes.
# Converting an acquired Thunderstore receipt into the fixed staging layout is
# an independent mutation and remains disabled even when downloads are enabled.
DYSON_MOD_IMPORT_ENABLED=false
DYSON_MOD_DEPLOYMENT_ENABLED=false
# Explicit broker-bound recovery is independent from ordinary mod publication.
DYSON_MOD_DEPLOYMENT_RECOVERY_ENABLED=false
# DYSON_MOD_STAGING_ROOT=C:\GameServer\Example\staged-mods
# Must be this exact subtree below DYSON_PROJECT_ROOT so ordinary mods can
# never replace Nebula, BepInEx, or Dyson Control's owned plugin directories.
# DYSON_MOD_PLUGINS_ROOT=C:\GameServer\Example\DSP\server\BepInEx\plugins\dyson-managed-mods
# DYSON_MOD_SNAPSHOT_LIMIT=8

# Backup/restore execution is a separate fail-closed gate. Preview remains
# available; restore also requires verified stopped-process and closed-port evidence.
DYSON_SAVE_MUTATIONS_ENABLED=false

# Backup annotation, recoverable retirement/restore and grace-period purge use
# a distinct Administrator gate. Permanent purge remains impossible before the
# server-side minimum age, regardless of browser state.
DYSON_SAVE_RETENTION_MUTATIONS_ENABLED=false
# DYSON_SAVE_RETENTION_PURGE_MINIMUM_HOURS=168

# Configuration snapshots remain readable when this gate is disabled. Creating
# snapshots, restoring one, and interrupted-restore reconciliation require it.
DYSON_CONFIG_HISTORY_MUTATIONS_ENABLED=false

# Raw paired-save export/import is separately administrator-only and disabled.
# Imports stop in a fixed quarantine and never restore the active save.
DYSON_SAVE_TRANSFER_ENABLED=false
# DYSON_SAVE_TRANSFER_ROOT=C:\GameServer\Example\DSP\transfers

# Real lifecycle execution is separately disabled even with the Windows status
# provider. Enable it only after installing the matching bridge and fixed tasks.
DYSON_LIFECYCLE_ENABLED=false
# DYSON_LIFECYCLE_TIMEOUT_MS=240000
# Fixed SYSTEM lifecycle broker profile installed under DYSON_DATA_DIR. Its
# value must be exactly <DataRoot>\data\lifecycle-broker\broker-profile.json.
# DYSON_LIFECYCLE_BROKER_PROFILE_FILE=C:\GameServer\Example\DysonControlData\data\lifecycle-broker\broker-profile.json
# Exact interactive Windows account bound into the broker profile and game tasks.
# DYSON_RUNTIME_SERVICE_USER=.\ExampleGameService
# DYSON_BRIDGE_CONTROL_ROOT=C:\GameServer\Example\DSP\run\control-bridge
# DYSON_BRIDGE_SECRET_FILE=C:\GameServer\Example\DysonControlData\bridge.secret
# DYSON_BRIDGE_PLUGIN_VERSION=0.1.0-rc.14
# DYSON_PLAYER_SNAPSHOT_MAX_AGE_MS=10000
# Fail-closed targeted system-notice gate. Only fixed Bridge-owned templates are accepted.
DYSON_PLAYER_NOTICE_MUTATIONS_ENABLED=false
# Privacy-bounded SQLite player presence event window. Both limits are enforced
# during ingest/access and by idle-time maintenance: capacity 1..2048 events,
# retention 1..720 hours. The current authoritative roster is stored separately.
# DYSON_PLAYER_HISTORY_CAPACITY=512
# DYSON_PLAYER_HISTORY_RETENTION_HOURS=168
# DYSON_SERVER_TASK=Dyson-Nebula-Server
# DYSON_STOP_TASK=Dyson-Nebula-Stop
# DYSON_GAME_PORT=27015
